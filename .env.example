# Required in production. Exact public app origin, without a trailing slash.
APP_ORIGIN=http://localhost:3000
# 12+ characters; never commit real values.
ADMIN_PASSWORD=
# Generate 32+ random bytes, e.g. openssl rand -hex 32
SESSION_SECRET=
# Vercel/serverless: remote libSQL URL and token, shared by all instances.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Alternative for a persistent Node host: file:/absolute/path/on/persistent-volume/mavro-ai.db
# Local development defaults to the existing ./mavro-ai.db (legacy tables retained).
DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Set ONLY when the host overwrites this header with a trusted client IP.
# Without it quotas are intentionally shared across visitors.
TRUSTED_IP_HEADER=
# Optional iframe integration: exact trusted parent HTTPS origins, comma-separated.
# No arbitrary website may embed the app unless it is listed here.
EMBED_ALLOWED_ORIGINS=

# Optional private object storage backend for internal tests (isolated from SQL databases)
MAVRO_STORAGE=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Preview-only internal admin access; relies on Vercel Authentication remaining enabled.
INTERNAL_TEST_MODE=
AI_GATEWAY_ENABLED=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
